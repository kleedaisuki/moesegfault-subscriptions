{
  "name": "moesegfault-subscriptions",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/subscribe"
  ],
  "scripts": {
    "build": "npm run build --workspace=@moesegfault/subscribe",
    "typecheck": "npm run typecheck --workspace=@moesegfault/subscribe",
    "test": "npm run test --workspace=@moesegfault/subscribe",
    "test:deployment": "node --test scripts/*.test.mjs scripts/tests/*.test.mjs",
    "package:billing": "wrangler deploy --dry-run --outdir=.temp/package/billing --config wrangler.billing.jsonc",
    "package:subscribe": "wrangler deploy --dry-run --outdir=.temp/package/subscribe --config wrangler.subscribe.jsonc",
    "deploy:staging": "node scripts/deployment-release.mjs",
    "deploy:production": "node scripts/deployment-release.mjs production",
    "smoke:staging": "node scripts/deployment-smoke.mjs",
    "smoke:production": "node scripts/deployment-smoke.mjs production",
    "plans:sync": "node scripts/deployment-plans.mjs",
    "plans:check": "node scripts/deployment-plans.mjs --check",
    "plans:sync:production": "node scripts/deployment-plans.mjs --environment production",
    "plans:check:production": "node scripts/deployment-plans.mjs --check --environment production"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
