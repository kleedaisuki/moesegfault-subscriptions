{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moesegfault-billing-staging",
  "main": "./crates/billing/build/worker/shim.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "routes": [
    {
      "pattern": "billing-staging.moesegfault.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "IDENTITY_ISSUER": "https://identity-staging.moesegfault.dev",
    "BILLING_AUDIENCES": "[\"subscribe-staging\"]",
    "PLAN_REGISTRY_JSON": "[{\"id\":\"platform-monthly\",\"product_id\":\"moesegfault-platform\",\"name\":{\"zh-CN\":\"平台月度订阅\",\"en\":\"Platform monthly\",\"ja\":\"プラットフォーム月額\"},\"description\":{\"zh-CN\":\"使用激活码开启 30 天平台订阅。\",\"en\":\"Activate 30 days of platform access with a code.\",\"ja\":\"コードで 30 日間のプラットフォーム利用を有効にします。\"},\"duration_days\":30,\"active\":true,\"entitlements\":[\"platform.access\"]},{\"id\":\"amail-free\",\"product_id\":\"amail\",\"name\":{\"en\":\"amail Free\",\"ja\":\"amail Free\",\"zh-CN\":\"amail Free\"},\"description\":{\"en\":\"Community email plan. Inbound mail and semantic search are unmetered; authorized overage accrues pending settlement.\",\"ja\":\"コミュニティメール。受信と意味検索は無料。承認済み超過利用は未決済として記録されます。\",\"zh-CN\":\"社区邮件套餐。收信与语义搜索不计费；超额用量需用户授权，待结算。\"},\"duration_days\":30,\"active\":true,\"entitlements\":[\"amail.plan.free\",\"amail.outbound.monthly.100\",\"amail.storage.bytes.200000000\",\"amail.addresses.1\"]},{\"id\":\"amail-lite\",\"product_id\":\"amail\",\"name\":{\"en\":\"amail Lite\",\"ja\":\"amail Lite\",\"zh-CN\":\"amail Lite\"},\"description\":{\"en\":\"Community email plan. Inbound mail and semantic search are unmetered; authorized overage accrues pending settlement.\",\"ja\":\"コミュニティメール。受信と意味検索は無料。承認済み超過利用は未決済として記録されます。\",\"zh-CN\":\"社区邮件套餐。收信与语义搜索不计费；超额用量需用户授权，待结算。\"},\"duration_days\":30,\"active\":true,\"entitlements\":[\"amail.plan.lite\",\"amail.outbound.monthly.1000\",\"amail.storage.bytes.2000000000\",\"amail.addresses.3\"]},{\"id\":\"amail-plus\",\"product_id\":\"amail\",\"name\":{\"en\":\"amail Plus\",\"ja\":\"amail Plus\",\"zh-CN\":\"amail Plus\"},\"description\":{\"en\":\"Community email plan. Inbound mail and semantic search are unmetered; authorized overage accrues pending settlement.\",\"ja\":\"コミュニティメール。受信と意味検索は無料。承認済み超過利用は未決済として記録されます。\",\"zh-CN\":\"社区邮件套餐。收信与语义搜索不计费；超额用量需用户授权，待结算。\"},\"duration_days\":30,\"active\":true,\"entitlements\":[\"amail.plan.plus\",\"amail.outbound.monthly.5000\",\"amail.storage.bytes.10000000000\",\"amail.addresses.5\"]}]",
    "EMAIL_FROM_ADDRESS": "subscribe@moesegfault.dev",
    "SUBSCRIBE_ORIGIN": "https://subscribe-staging.moesegfault.dev",
    "AMAIL_RETURN_URL_ALLOWLIST": "[\"https://amail-staging.moesegfault.dev/billing/return\"]"
  },
  "d1_databases": [
    {
      "binding": "BILLING_DB",
      "database_name": "moesegfault-billing-staging",
      "database_id": "47022fe7-0e14-4bbb-a52a-c59358b938b1",
      "migrations_dir": "migrations/billing"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "subscribe@moesegfault.dev"
      ]
    }
  ],
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
