{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moesegfault-subscribe",
  "main": "./crates/subscribe/build/worker/shim.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "routes": [
    {
      "pattern": "subscribe.moesegfault.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./apps/subscribe/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ISSUER": "https://identity.moesegfault.dev",
    "CLIENT_ID": "subscribe",
    "CLIENT_KEY_ID": "subscribe-production-20261005",
    "APP_ORIGIN": "https://subscribe.moesegfault.dev",
    "ACCOUNT_ORIGIN": "https://account.moesegfault.dev",
    "RETURN_URL_ALLOWLIST": "[\"https://account.moesegfault.dev/subscriptions\"]"
  },
  "d1_databases": [
    {
      "binding": "SESSIONS",
      "database_name": "moesegfault-subscribe-production",
      "database_id": "d1d08305-d763-44bf-83ae-fa9839b14015",
      "migrations_dir": "migrations/subscribe"
    }
  ],
  "services": [
    {
      "binding": "BILLING",
      "service": "moesegfault-billing"
    }
  ],
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    },
    "issues": {
      "enabled": false
    }
  },
  "logpush": false
}
